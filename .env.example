DATABASE_URL="postgresql://coherence:coherence_secret@localhost:5432/coherence_engine"
PORT=3000
HOST=0.0.0.0
# IMPORTANT: Replace this with a long random secret before deploying.
# This value is publicly known and MUST NOT be used in production.
# Generate one with: openssl rand -hex 32
API_KEY=dev-api-key-change-in-prod
# Per-minute cap per X-API-Key (or IP). Lower in prod to limit accident spend, e.g. 120
API_RATE_LIMIT_MAX=1000
# Monthly tier usage caps for workspace keys / JWT (master API_KEY uncapped). Default off in dev, on in production.
# ENFORCE_USAGE_CAPS=false
LOG_LEVEL=info

# Coherence energy weights (Phi = lambda_c*Vc + lambda_k*Vk + lambda_d*Vd + lambda_u*Vu + lambda_b*Vb)
COHERENCE_LAMBDA_C=1.0
COHERENCE_LAMBDA_K=1.5
COHERENCE_LAMBDA_D=0.8
COHERENCE_LAMBDA_U=0.5
COHERENCE_LAMBDA_B=0.7
COHERENCE_K_SCALE=2.0

# Staleness decay constant: Staleness(k) = 1 - exp(-lambda_s * (t - tau_k))
STALENESS_LAMBDA=0.001

# Contradiction scoring thresholds
CONTRADICTION_THRESHOLD=0.5
BRANCH_THRESHOLD=0.7

# Action validation budget
ACTION_BUDGET=5.0
ACTION_EPSILON=0.6

# Stripe Billing
# Get these from https://dashboard.stripe.com — monthly recurring prices
# STRIPE_SECRET_KEY is also read by the Cursor MCP server "proposalforge-stripe" (see docs/stripe-setup.md).
STRIPE_SECRET_KEY=sk_test_...
# Create with: npm run stripe:invariant-prices  (from repo root, STRIPE_SECRET_KEY set)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_... # Optional: self-serve enterprise; else use Contact sales only
STRIPE_WEBHOOK_SECRET=whsec_...    # From: stripe listen --forward-to localhost:3000/checkout/webhook
STRIPE_SUCCESS_URL=https://invariant.me/success.html
STRIPE_CANCEL_URL=https://invariant.me/pricing.html

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-prod
JWT_EXPIRES_IN=7d

# GitHub OAuth
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Set Authorization callback URL to: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
FRONTEND_URL=http://localhost:8080

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jack@thestardrive.com
SMTP_PASS=your-app-password
SMTP_FROM=Invariant <jack@thestardrive.com>
