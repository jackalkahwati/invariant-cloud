// Coherence Engine - PostgreSQL Schema
// World state graph: G = (V, E, C, D, B)
// V = entities, E = claims, C = constraints, D = dependencies, B = branches

generator client {
  provider      = "prisma-client-js"
  // Vercel serverless runs on Linux (glibc + OpenSSL 3)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENTITIES (V) — persistent things in the world
// ============================================================

model Entity {
  id          String   @id @default(cuid())
  name        String
  type        EntityType
  description String?
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims            Claim[]
  dependenciesFrom  Dependency[] @relation("depFrom")
  dependenciesTo    Dependency[] @relation("depTo")
  auditEvents       AuditEvent[]

  @@map("entities")
}

enum EntityType {
  PERSON
  PROJECT
  REQUIREMENT
  FILE
  TASK
  SUBSYSTEM
  COMPONENT
  EXPERIMENT
  AGENT
  HYPOTHESIS
  CONSTRAINT_TARGET
  ENVIRONMENT_STATE
  GENERIC
}

// ============================================================
// SOURCES — who or what asserted a claim
// ============================================================

model Source {
  id          String     @id @default(cuid())
  name        String
  type        SourceType
  trustScore  Float      @default(0.8)
  metadata    Json?
  createdAt   DateTime   @default(now())

  claims       Claim[]
  observations Observation[]

  @@map("sources")
}

enum SourceType {
  AGENT
  HUMAN
  TOOL
  SYSTEM
  SENSOR
}

// ============================================================
// CLAIMS (E) — structured assertions about entities
// ============================================================

model Claim {
  id           String      @id @default(cuid())
  entityId     String
  entity       Entity      @relation(fields: [entityId], references: [id])
  predicate    String      // e.g. "status", "mass", "isCritical"
  value        Json        // structured value
  confidence   Float       @default(1.0)
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id])
  timestamp    DateTime    @default(now())
  status       ClaimStatus @default(ACTIVE)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  supersededBy String?     // id of the claim that superseded this one
  observationId String?
  observation  Observation? @relation(fields: [observationId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  evidence            ClaimEvidence[]
  provenanceAsTarget  ProvenanceEdge[] @relation("provenanceTarget")
  provenanceAsSource  ProvenanceEdge[] @relation("provenanceSource")
  contradictionsAsA   Contradiction[]  @relation("contradictionClaimA")
  contradictionsAsB   Contradiction[]  @relation("contradictionClaimB")

  @@map("claims")
}

enum ClaimStatus {
  ACTIVE
  SUPERSEDED
  DISPUTED
  INVALIDATED
  BRANCH_SPECIFIC
}

// ============================================================
// CLAIM EVIDENCE — links claims to supporting evidence
// ============================================================

model ClaimEvidence {
  id          String   @id @default(cuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id])
  type        String
  reference   String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("claim_evidence")
}

// ============================================================
// PROVENANCE EDGES — how claims derive from each other
// ============================================================

model ProvenanceEdge {
  id            String   @id @default(cuid())
  sourceClaimId String
  targetClaimId String
  sourceClaim   Claim    @relation("provenanceSource", fields: [sourceClaimId], references: [id])
  targetClaim   Claim    @relation("provenanceTarget", fields: [targetClaimId], references: [id])
  type          String   // derived_from, supports, contradicts, supersedes
  createdAt     DateTime @default(now())

  @@map("claim_provenance_edges")
}

// ============================================================
// CONSTRAINTS (C) — rules that must hold
// ============================================================

model Constraint {
  id          String         @id @default(cuid())
  name        String
  description String
  type        ConstraintType
  expression  Json           // structured rule expression
  entityIds   String[]       // entities this constraint applies to
  weight      Float          @default(1.0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  violations ConstraintViolation[]

  @@map("constraints")
}

enum ConstraintType {
  NUMERIC_RANGE
  STATUS_DEPENDENCY
  VERIFICATION_REQUIRED
  MUTUAL_EXCLUSION
  COMPLETENESS
  CUSTOM
}

model ConstraintViolation {
  id           String     @id @default(cuid())
  constraintId String
  constraint   Constraint @relation(fields: [constraintId], references: [id])
  entityIds    String[]
  claimIds     String[]
  severity     Float
  description  String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@map("constraint_violations")
}

// ============================================================
// DEPENDENCIES (D) — signed typed relations
// ============================================================

model Dependency {
  id           String         @id @default(cuid())
  fromEntityId String
  toEntityId   String
  fromEntity   Entity         @relation("depFrom", fields: [fromEntityId], references: [id])
  toEntity     Entity         @relation("depTo",   fields: [toEntityId],   references: [id])
  type         DependencyType
  weight       Float          @default(1.0)
  description  String?
  metadata     Json?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  @@unique([fromEntityId, toEntityId, type])
  @@map("dependencies")
}

enum DependencyType {
  SUPPORTS       // A supports B (positive consensus)
  REQUIRES       // A requires B to hold
  IMPLIES        // A being true implies B
  INVALIDATES    // A being true invalidates B
  EXCLUDES       // A and B cannot coexist
  MUTEX          // A and B are mutually exclusive states
  IMPLIES_NOT    // A implies B is false
}

// ============================================================
// CONTRADICTIONS — detected inconsistencies
// ============================================================

model Contradiction {
  id          String                @id @default(cuid())
  claimAId    String
  claimBId    String
  claimA      Claim                 @relation("contradictionClaimA", fields: [claimAId], references: [id])
  claimB      Claim                 @relation("contradictionClaimB", fields: [claimBId], references: [id])
  score       Float                 // ContradictionScore(p,q)
  severity    ContradictionSeverity
  type        ContradictionType
  status      ContradictionStatus   @default(OPEN)
  branchId    String?               // branch created to house this contradiction
  resolution  String?
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("contradictions")
}

enum ContradictionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContradictionStatus {
  OPEN
  RESOLVED
  BRANCHED
}

enum ContradictionType {
  NUMERIC_CONFLICT
  STATUS_CONFLICT
  TEMPORAL_CONFLICT
  MUTEX_TAG_CONFLICT
  RANGE_THRESHOLD_CONFLICT
  SEMANTIC       // stub only in v1
}

// ============================================================
// BRANCHES (B) — alternative coherent state paths
// ============================================================

model Branch {
  id              String       @id @default(cuid())
  name            String
  description     String?
  parentBranchId  String?
  status          BranchStatus @default(OPEN)
  confidence      Float        @default(0.5)
  contradictionId String?      // the contradiction that triggered this branch
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  claims      Claim[]
  auditEvents AuditEvent[]

  @@map("branches")
}

enum BranchStatus {
  OPEN
  RESOLVED
  MERGED
  REJECTED
}

// ============================================================
// OBSERVATIONS — raw inputs that generate claims
// ============================================================

model Observation {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  type        String
  content     Json
  entityIds   String[]
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  claims Claim[]

  @@map("observations")
}

// ============================================================
// ACTION PROPOSALS — proposed actions to validate
// ============================================================

model ActionProposal {
  id                String       @id @default(cuid())
  operation         String
  description       String?
  parameters        Json
  impactedEntityIds String[]
  sourceId          String?
  branchId          String?
  provenanceChain   Json         @default("[]")
  status            ActionStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  validations ActionValidation[]

  @@map("action_proposals")
}

enum ActionStatus {
  PENDING
  VALID
  RISKY
  BLOCKED
  BRANCH_DEPENDENT
}

// ============================================================
// ACTION VALIDATIONS — results of coherence checks
// ============================================================

model ActionValidation {
  id                      String       @id @default(cuid())
  actionProposalId        String
  actionProposal          ActionProposal @relation(fields: [actionProposalId], references: [id])
  admissibility           ActionStatus

  // DeltaPhi(a) = Phi(G after action) - Phi(G current)
  deltaPhi                Float

  // Psi(a,G) = mu1*CVR + mu2*DBR + mu3*CA + mu4*UE + mu5*PF + mu6*PropagatedRisk
  psiScore                Float
  constraintViolationRisk Float
  dependencyBreakageRisk  Float
  contradictionAmplification Float
  uncertaintyExposure     Float
  provenanceFragility     Float
  propagatedRisk          Float  @default(0)  // Phase 1: transitive risk via dependency graph

  impactedEntityIds       String[]
  provenanceChain         Json     @default("[]")
  reasons                 String[]
  createdAt               DateTime @default(now())

  @@map("action_validations")
}

// ============================================================
// STATE SNAPSHOTS — periodic world state captures
// ============================================================

model StateSnapshot {
  id                       String   @id @default(cuid())
  phi                      Float    // total incoherence energy
  coherenceScore           Float    // CoherenceScore = 100 * exp(-k * Phi_norm)
  entityCount              Int
  claimCount               Int
  activeClaimCount         Int
  contradictionCount       Int
  openContradictionCount   Int
  branchCount              Int
  openBranchCount          Int
  constraintViolationCount Int
  lambdaC                  Float
  lambdaK                  Float
  lambdaD                  Float
  lambdaU                  Float
  lambdaB                  Float
  metadata                 Json?
  createdAt                DateTime @default(now())

  @@map("state_snapshots")
}

// ============================================================
// AUDIT EVENTS — complete audit trail
// ============================================================

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  actorId   String?
  data      Json
  createdAt DateTime @default(now())

  @@map("audit_events")
}

// ============================================================
// INVARIANT POLICY — governance, approvals, escalation
// ============================================================

model PolicyRule {
  id          String         @id @default(cuid())
  name        String
  description String?
  layer       PolicyLayer    @default(POLICY)
  condition   Json           // structured condition expression
  effect      PolicyEffect
  severity    PolicySeverity @default(MEDIUM)
  entityTypes String[]       // empty = applies to all entity types
  operations  String[]       // empty = applies to all operations
  priority    Int            @default(0)
  isActive    Boolean        @default(true)
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  approvalRequests ApprovalRequest[]
  evaluations      PolicyEvaluation[]

  @@map("policy_rules")
}

enum PolicyLayer {
  INGESTION
  STATE
  POLICY
  PLAN
  EXECUTION
  TRACE
}

enum PolicyEffect {
  ALLOW
  DENY
  REQUIRE_APPROVAL
  ESCALATE
  WARN
}

enum PolicySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ApprovalRequest {
  id               String         @id @default(cuid())
  policyRuleId     String
  policyRule       PolicyRule     @relation(fields: [policyRuleId], references: [id])
  actionProposalId String?
  requestedBy      String
  reason           String
  status           ApprovalStatus @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  decision         String?
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("approval_requests")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  ESCALATED
}

model PolicyEvaluation {
  id               String        @id @default(cuid())
  policyRuleId     String
  policyRule       PolicyRule    @relation(fields: [policyRuleId], references: [id])
  actionProposalId String?
  entityIds        String[]
  triggered        Boolean
  effect           PolicyEffect?
  reason           String?
  metadata         Json?
  createdAt        DateTime      @default(now())

  @@map("policy_evaluations")
}

// ============================================================
// INVARIANT TRACE — timeline, replay, audit sessions
// ============================================================

model TraceSession {
  id          String      @id @default(cuid())
  name        String
  description String?
  agentId     String?
  status      TraceStatus @default(ACTIVE)
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  metadata    Json?
  createdAt   DateTime    @default(now())

  events TraceEvent[]

  @@map("trace_sessions")
}

enum TraceStatus {
  ACTIVE
  COMPLETED
  FAILED
  REPLAYING
}

model TraceEvent {
  id              String         @id @default(cuid())
  sessionId       String
  session         TraceSession   @relation(fields: [sessionId], references: [id])
  type            TraceEventType
  sequenceNumber  Int
  entityIds       String[]
  data            Json
  worldStateHash  String?
  deltaPhiAfter   Float?
  coherenceAfter  Float?
  actorId         String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@unique([sessionId, sequenceNumber])
  @@map("trace_events")
}

enum TraceEventType {
  CLAIM_ADDED
  CLAIM_INVALIDATED
  CLAIM_SUPERSEDED
  CONTRADICTION_DETECTED
  BRANCH_OPENED
  BRANCH_RESOLVED
  CONSTRAINT_VIOLATED
  DEPENDENCY_ADDED
  ACTION_PROPOSED
  ACTION_VALIDATED
  POLICY_TRIGGERED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  SETTLING_ROUND
  WORLD_SNAPSHOT
  PLAN_CREATED
  PLAN_STEP_STARTED
  PLAN_STEP_COMPLETED
  PLAN_STEP_FAILED
  AGENT_MESSAGE
}

// ============================================================
// INVARIANT PLAN — task decomposition, orchestration
// ============================================================

model Plan {
  id          String     @id @default(cuid())
  name        String
  description String?
  goal        String
  agentId     String?
  status      PlanStatus @default(DRAFT)
  entityIds   String[]
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  steps PlanStep[]

  @@map("plans")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  REPLANNING
}

model PlanStep {
  id               String         @id @default(cuid())
  planId           String
  plan             Plan           @relation(fields: [planId], references: [id])
  name             String
  description      String?
  operation        String
  parameters       Json           @default("{}")
  entityIds        String[]
  status           PlanStepStatus @default(PENDING)
  assignedTo       String?
  order            Int
  requires         String[]
  startedAt        DateTime?
  completedAt      DateTime?
  failureReason    String?
  actionProposalId String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("plan_steps")
}

enum PlanStepStatus {
  PENDING
  READY
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  SKIPPED
}

// ============================================================
// WORKSPACES — multi-tenant billing units
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String?
  githubId     String?   @unique
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaces WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id                     String          @id @default(cuid())
  name                   String
  slug                   String          @unique
  stripeCustomerId       String?         @unique
  stripeSubscriptionId   String?         @unique
  tier                   WorkspaceTier   @default(FREE)
  status                 WorkspaceStatus @default(ACTIVE)
  trialEndsAt            DateTime?
  claimsThisMonth        Int             @default(0)
  claimsResetAt          DateTime        @default(now())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  members WorkspaceMember[]
  apiKeys WorkspaceApiKey[]

  @@map("workspaces")
}

enum WorkspaceTier {
  FREE
  STARTER
  TEAM
  ENTERPRISE
}

enum WorkspaceStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String    @default("Default")
  keyPrefix   String    // first 8 chars, for display (e.g. "inv_a1b2")
  keyHash     String    @unique // bcrypt hash of the full key
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("workspace_api_keys")
}
